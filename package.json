{
  "name": "python-quest",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-pyodide.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "check": "npm test && npm run test:e2e",
    "format": "prettier --write src scripts tests e2e *.js *.json *.html docs/*.md README.md",
    "test:pages": "node scripts/test-pages.mjs"
  },
  "dependencies": {
    "phaser": "3.90.0",
    "pyodide": "0.27.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "prettier": "^3.9.10",
    "vite": "^7.1.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.12"
  }
}
